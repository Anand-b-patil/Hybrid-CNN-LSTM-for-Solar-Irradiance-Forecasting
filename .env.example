# Solar Forecasting API Configuration
# Copy this file to .env and update values as needed

# API Settings
APP_NAME="Solar Forecasting API"
APP_VERSION="1.0.0"
DEBUG=False
HOST=127.0.0.1
PORT=5000

# CORS Settings - IMPORTANT: Update with your frontend domain in production
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:5000"]

# File Upload Settings
UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE=10485760
MAX_SEQUENCE_IMAGES=100
MIN_SEQUENCE_IMAGES=10

# Model Paths
CNN_MODEL_PATH=models/best_efficientnet_model.pth
LSTM_MODEL_PATH=models/best_lstm_model.pth
HYBRID_MODEL_PATH=models/best_hybrid_model.pth

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# ==================== Gemini AI Configuration ====================
# Get your API key from: https://makersuite.google.com/app/apikey
# Uncomment and add your actual API key to enable AI features
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (options: gemini-1.5-flash, gemini-1.5-pro)
# gemini-1.5-flash: Faster, lower cost, good for most use cases
# gemini-1.5-pro: More capable, higher cost, better for complex analysis
GEMINI_MODEL=gemini-1.5-flash

# Gemini generation parameters
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2048
GEMINI_TIMEOUT=30
